DATABASE_URL=postgresql+asyncpg://phoenix:phoenix@localhost:5432/phoenix
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SIGN_VARIANTS=rsl=mvit32-2,asl=signflow-a
SIGN_LANGUAGES_ENABLED=rsl,asl
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
UPLOAD_DIR=uploads
# Gemini (Google AI Studio). Never commit the real key; .env is git-ignored.
GEMINI_API_KEY=
STT_ENGINE=auto
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
GEMINI_SENTENCE_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
SMOOTH_BY_DEFAULT=true
# Sign-in for the mobile app (optional). Normally set in config/auth.json (public IDs, committed);
# these override it. GITHUB_CLIENT_SECRET is optional and must never be committed.
GOOGLE_CLIENT_IDS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
